# Polymarket CLOB API Configuration
# Get your private key from your wallet (MetaMask, etc.)
POLY_PRIVATE_KEY=0xyour_private_key_here

# Your funder address (the address that holds funds on Polymarket)
POLY_FUNDER_ADDRESS=0xyour_funder_address_here

# Signature type: 0 = EOA, 1 = Proxy/Magic, 2 = Browser wallet
POLY_SIGNATURE_TYPE=0

# Chain ID (137 = Polygon mainnet)
POLY_CHAIN_ID=137

# CLOB API host
POLY_CLOB_HOST=https://clob.polymarket.com

# Gamma API host (for market metadata)
POLY_GAMMA_HOST=https://gamma-api.polymarket.com

# ── Strategy Settings ──────────────────────────────────────────
# Maximum amount (USDC) per single trade
MAX_TRADE_SIZE=10.0

# Maximum total exposure across all positions
MAX_TOTAL_EXPOSURE=100.0

# Minimum edge required before placing a trade (e.g., 0.05 = 5%)
MIN_EDGE=0.05

# How often to scan markets (seconds)
SCAN_INTERVAL=60

# Strategy to use: value_finder | midpoint_scalper | volume_momentum
STRATEGY=value_finder

# Dry run mode (true = simulate trades without executing)
DRY_RUN=true

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
